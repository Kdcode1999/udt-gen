# Copy this file to `.env` (same folder) and paste your keys after the = signs.
# Both the app (pnpm dev) and the CLI (pnpm vo / render / images …) read it on start.
# `.env` is git-ignored — never commit it. A key set in the PowerShell window wins over this file.

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=

